{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "version", "source", "source_url", "reviewed_at", "applicability", "items"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "string"},
    "source": {"type": "string"},
    "source_url": {"type": "string", "format": "uri"},
    "reviewed_at": {"type": "string", "format": "date"},
    "applicability": {"type": "object", "required": ["region"], "additionalProperties": true},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "condition", "action", "severity"],
        "properties": {
          "id": {"type": "string"},
          "condition": {"type": "string"},
          "action": {"type": "string"},
          "severity": {"enum": ["info", "warning", "urgent"]}
        }
      }
    }
  }
}
