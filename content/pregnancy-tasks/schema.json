{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "version", "source", "source_url", "reviewed_at", "applicability", "items"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "reviewed_at": {"type": "string", "format": "date"},
    "applicability": {"$ref": "#/$defs/applicability"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "applicability": {
      "type": "object",
      "required": ["region", "gestational_weeks"],
      "properties": {
        "region": {"type": "array", "items": {"type": "string"}},
        "gestational_weeks": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": ["id", "title", "summary", "due_in_days", "source_type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "due_in_days": {"type": "integer"},
        "source_type": {"const": "template"},
        "priority": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  }
}
