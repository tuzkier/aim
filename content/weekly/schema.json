{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "version", "source", "source_url", "reviewed_at", "weeks"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "string"},
    "source": {"type": "string"},
    "source_url": {"type": "string", "format": "uri"},
    "reviewed_at": {"type": "string", "format": "date"},
    "weeks": {
      "type": "array",
      "minItems": 39,
      "maxItems": 39,
      "items": {
        "type": "object",
        "required": ["week", "fruit", "fruit_name", "length_cm", "weight_g", "baby", "mom", "tips"],
        "properties": {
          "week": {"type": "integer", "minimum": 4, "maximum": 42},
          "fruit": {"type": "string", "minLength": 1},
          "fruit_name": {"type": "string", "minLength": 1},
          "length_cm": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "weight_g": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "baby": {"type": "string", "minLength": 4, "maxLength": 80},
          "mom": {"type": "string", "minLength": 4, "maxLength": 80},
          "tips": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {"type": "string", "minLength": 2, "maxLength": 30}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
