{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "version", "source", "source_url", "reviewed_at", "applicability", "items"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "string"},
    "source": {"type": "string"},
    "source_url": {"type": "string", "format": "uri"},
    "reviewed_at": {"type": "string", "format": "date"},
    "applicability": {
      "type": "object",
      "required": ["region"],
      "properties": {
        "region": {"type": "array", "items": {"type": "string"}},
        "suggested_from_week": {"type": "integer", "minimum": 0, "maximum": 42}
      },
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "summary"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "group": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
