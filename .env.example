# Business API
DATABASE_URL=postgresql+psycopg://aim:aim@localhost:5432/aim
API_HOST=0.0.0.0
API_PORT=8000

# Agent Runtime
EVE_HOST=http://localhost:3100
EVE_PORT=3100
EVE_WORKFLOW_DATA_DIR=.workflow-data
EVE_USE_MOCK_MODEL=1
AIM_AGENT_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Required only when EVE_USE_MOCK_MODEL=0. Keep this in local .env or a secret manager.
DEEPSEEK_API_KEY=

# Development only; never commit real credentials.
MODEL_PROVIDER=mock

# Internal Tool API; replace both development secrets outside local work.
AUTH_SECRET=aim-development-secret
AGENT_SERVICE_SECRET=aim-agent-development-secret
